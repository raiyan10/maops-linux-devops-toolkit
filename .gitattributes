# Normalize text files and use Linux line endings
* text=auto

*.sh       text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.txt      text eol=lf
*.gitignore text eol=lf
Makefile   text eol=lf
LICENSE    text eol=lf

# Binary files must not be modified
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
