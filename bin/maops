#!/usr/bin/env bash

###############################################################################
#
# Script Name : maops
# Description : Unified CLI dispatcher for the MAOps Linux DevOps Toolkit
# Author      : Raiyan Yousuf
# Project     : MAOps Linux DevOps Toolkit
#
###############################################################################

set -euo pipefail

# Resolves this script's real location by following symlinks manually
# (bounded, to guard against a cycle), so an installed launcher symlinked as
# PREFIX/bin/maops -> ../lib/maops/bin/maops still finds its real REPO_ROOT.
# Deliberately avoids `readlink -f`/`realpath`, since neither is guaranteed
# to be present and neither is on the toolkit's required-command list.
resolve_script_path() {
    local target="${BASH_SOURCE[0]}"
    local dir hops=0

    while [[ -L "$target" ]]; do
        hops=$((hops + 1))
        if ((hops > 40)); then
            echo "maops: too many levels of symbolic links: ${BASH_SOURCE[0]}" >&2
            exit 1
        fi

        dir="$(cd "$(dirname "$target")" && pwd)"
        target="$(readlink "$target")"
        [[ "$target" != /* ]] && target="$dir/$target"
    done

    cd "$(dirname "$target")" && pwd
}

SCRIPT_DIR="$(resolve_script_path)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=scripts/common/bootstrap.sh
source "$REPO_ROOT/scripts/common/bootstrap.sh"

###############################################################################
# Usage
###############################################################################

usage() {
    cat <<EOF
$PROJECT_NAME — unified CLI

Usage:
    maops help | --help | -h
    maops version | --version
    maops <group> <command> [ARGS...]

Groups and commands:
    system      info | os | hostname
    monitoring  memory | cpu | load
    filesystem  disk | largest [PATH] [LIMIT] | temp [PATH] [LIMIT]
    network     info | ping HOST [COUNT] | dns HOSTNAME | port HOST PORT [TIMEOUT]
    user        report [USERNAME]
    process     top [LIMIT] [cpu|memory]
    service     status SERVICE
    config      path | init [--force] | show [--format text|json] | validate [PATH]
    doctor      [--format text|json]
    integrity   [--format text|json]

Examples:
    maops system info
    maops monitoring memory
    maops filesystem largest /var/log 20
    maops network ping example.com 4
    maops user report
    maops process top 15 memory
    maops service status cron
    maops config init
    maops doctor
    maops integrity
EOF
}

###############################################################################
# Error handling
###############################################################################

usage_error() {
    log_error "$1"
    usage >&2
    exit 2
}

###############################################################################
# Group dispatch
###############################################################################

dispatch_system() {
    local action="$1"
    shift

    case "$action" in
        info) exec "$REPO_ROOT/scripts/system/system-info.sh" "$@" ;;
        os) exec "$REPO_ROOT/scripts/system/os-details.sh" "$@" ;;
        hostname) exec "$REPO_ROOT/scripts/system/hostname-report.sh" "$@" ;;
        *) usage_error "Unknown system command: $action (expected: info, os, hostname)" ;;
    esac
}

dispatch_monitoring() {
    local action="$1"
    shift

    case "$action" in
        memory) exec "$REPO_ROOT/scripts/monitoring/memory-report.sh" "$@" ;;
        cpu) exec "$REPO_ROOT/scripts/monitoring/cpu-monitor.sh" "$@" ;;
        load) exec "$REPO_ROOT/scripts/monitoring/load-average.sh" "$@" ;;
        *) usage_error "Unknown monitoring command: $action (expected: memory, cpu, load)" ;;
    esac
}

dispatch_filesystem() {
    local action="$1"
    shift

    case "$action" in
        disk) exec "$REPO_ROOT/scripts/filesystem/disk-usage.sh" "$@" ;;
        largest) exec "$REPO_ROOT/scripts/filesystem/largest-files.sh" "$@" ;;
        temp) exec "$REPO_ROOT/scripts/filesystem/cleanup-temp.sh" "$@" ;;
        *) usage_error "Unknown filesystem command: $action (expected: disk, largest, temp)" ;;
    esac
}

dispatch_network() {
    local action="$1"
    shift

    case "$action" in
        info) exec "$REPO_ROOT/scripts/network/network-info.sh" "$@" ;;
        ping) exec "$REPO_ROOT/scripts/network/ping-check.sh" "$@" ;;
        dns) exec "$REPO_ROOT/scripts/network/dns-lookup.sh" "$@" ;;
        port) exec "$REPO_ROOT/scripts/network/port-check.sh" "$@" ;;
        *) usage_error "Unknown network command: $action (expected: info, ping, dns, port)" ;;
    esac
}

dispatch_user() {
    local action="$1"
    shift

    case "$action" in
        report) exec "$REPO_ROOT/scripts/users/user-report.sh" "$@" ;;
        *) usage_error "Unknown user command: $action (expected: report)" ;;
    esac
}

dispatch_process() {
    local action="$1"
    shift

    case "$action" in
        top) exec "$REPO_ROOT/scripts/process/process-monitor.sh" "$@" ;;
        *) usage_error "Unknown process command: $action (expected: top)" ;;
    esac
}

dispatch_service() {
    local action="$1"
    shift

    case "$action" in
        status) exec "$REPO_ROOT/scripts/service/service-status.sh" "$@" ;;
        *) usage_error "Unknown service command: $action (expected: status)" ;;
    esac
}

# config and doctor own their own subcommand/flag parsing (config-manager.sh
# and doctor.sh respectively), so — unlike the groups above — these are
# simple passthroughs with no "missing command for group" pre-check and no
# per-action case statement here.
dispatch_config() {
    exec "$REPO_ROOT/scripts/config/config-manager.sh" "$@"
}

dispatch_doctor() {
    exec "$REPO_ROOT/scripts/diagnostics/doctor.sh" "$@"
}

dispatch_integrity() {
    exec "$REPO_ROOT/scripts/diagnostics/integrity-check.sh" "$@"
}

###############################################################################
# Main
###############################################################################

main() {
    if (($# == 0)); then
        usage_error "Missing command."
    fi

    case "$1" in
        help | --help | -h)
            usage
            exit 0
            ;;

        version | --version)
            cli_show_version
            exit 0
            ;;

        system | monitoring | filesystem | network | user | process | service)
            local group="$1"
            shift

            if (($# == 0)); then
                usage_error "Missing command for group: $group"
            fi

            "dispatch_$group" "$@"
            ;;

        config)
            shift
            dispatch_config "$@"
            ;;

        doctor)
            shift
            dispatch_doctor "$@"
            ;;

        integrity)
            shift
            dispatch_integrity "$@"
            ;;

        *)
            usage_error "Unknown command or group: $1 (expected: help, version, system, monitoring, filesystem, network, user, process, service, config, doctor, integrity)"
            ;;
    esac
}

main "$@"
